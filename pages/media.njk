---
title: Media & Press
metaDescription: Recordings, cast albums, sessions, and performances featuring Xander Dawson.
permalink: /media/
usesGallery: true
---

<section class="section media-page">
{% containerImage "flute_explora.jpg" %}
  <article class="content">
<h2>Woodwind Doubling Reel</h2>

<iframe width="100%" height="500" src="https://www.youtube.com/embed/eWnUhB-ZQCM?si=U6-o355JB_SwClfN" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>

<p style="text-align: center"><a href="https://www.youtube.com/channel/UCPfyuV99V6vOAUSYS7VrwZw" class="button">View My YouTube Channel</a>
</p>

<h2>Media</h2>

    <p class="media-intro">
      A selection of recordings, cast albums, sessions, and performances
      featuring Xander Dawson on saxophone, clarinet, and flute.
    </p>

    <div class="media-grid">
      {% for item in media %}
        <a
          class="media-card media-card--{{ item.type }}"
          href="{{ item.url }}"
          target="_blank"
          rel="noopener noreferrer"
        >
          <div class="media-art">
            <img
              src="{{ item.image }}"
              alt="{{ item.title }} by {{ item.artist }}"
              loading="lazy"
            >

            <div class="media-overlay">
              <span class="media-play">
                {% if item.type == "youtube" or item.type == "soundcloud" %}
                  ▶
                {% else %}
                  ↗
                {% endif %}
              </span>
            </div>

            {# <span class="media-type">
              {% if item.type == "spotify" %}
                Spotify
              {% elif item.type == "youtube" %}
                YouTube
              {% else %}
                SoundCloud
              {% endif %}
            </span> #}
          </div>

          <div class="media-info">
            <h2>{{ item.title }}</h2>
            <p class="media-artist">{{ item.artist }}</p>
            <p class="media-role">{{ item.role }}</p>
          </div>
        </a>
      {% endfor %}
    </div>

    <h2>Press</h2>

    <div class="gallery js-flickity media-carousel"
  data-flickity-options='{ 
    "watchCSS": true, "wrapAround": false, "freeScroll": true,
"contain": true,
"prevNextButtons": true,
"pageDots": true
  }'>

  {% for item in press %}
    <article class="press-card{% if item.background %} press-card--image{% endif %}">
      <a
        href="{{ item.url }}"
        target="_blank"
        rel="noopener noreferrer"
        class="press-card__link"
        {% if item.background %}
        style="--press-background: url('{{ item.background }}');"
        {% endif %}
      >
        <div class="press-card__background" aria-hidden="true"></div>

        <div class="press-card__content">
          <div class="press-card__top">
            <span class="press-card__date">{{ item.date }}</span>
            <span class="press-card__arrow" aria-hidden="true">↗</span>
          </div>

          <div class="press-card__body">
            <p class="press-card__publisher">{{ item.publisher }}</p>
            <h2 class="press-card__title">{{ item.title | trim }}</h2>
          </div>

          <div class="press-card__footer">
            <span>Read article</span>
          </div>
        </div>
      </a>
    </article>
  {% endfor %}

</div>




  </article>
</section>